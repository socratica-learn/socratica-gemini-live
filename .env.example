SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/socratica_dev
MONGODB_DATABASE=socratica_dev

JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@socratica.com

# Local development can use either:
# - GEMINI_API_KEY for backend Gemini calls
# - Vertex AI Application Default Credentials for full parity, including live voice
#
# Create a Vertex AI API key:
# https://cloud.google.com/vertex-ai/generative-ai/docs/start/api-keys
#
# Live voice sessions still use the backend Vertex AI websocket proxy, so they
# require GOOGLE_CLOUD_PROJECT plus `gcloud auth application-default login`.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=project-8d21f1f6-2009-4dcf-bff
GOOGLE_CLOUD_REGION=europe-west4
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Frontend settings
VITE_API_BASE_URL=http://localhost:8080/api
